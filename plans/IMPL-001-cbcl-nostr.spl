;; =============================================================================
;; IMPL-001: CBCL-Nostr — Agent Communication over Nostr Relays
;; =============================================================================
;; Implements NIP-XX (nip-xx-agent-communication.md) using cbcl-rs primitives
;; mapped to Nostr event kinds 21111 (messages) and 31111 (dialects).
;;
;; Spec: SPEC-001 (nip-xx-agent-communication.md)
;; Upstream: cbcl-rs (../cbcl-rs) — formally verified CBCL runtime
;; Protocol: USDD Agent Protocol (../handbook/engineering/usdd-agent-protocol.md)
;; =============================================================================

(meta plan
  (id "IMPL-001")
  (title "CBCL-Nostr: Agent Communication over Nostr")
  (version "1.1.0")
  (status "active")
  (created "2026-03-18")
  (author "agent:architect")
  (spec "SPEC-001")
  (description "Implement CBCL agent communication protocol over Nostr relays, mapping cbcl-rs core (S-expressions, performatives, dialects, R1-R4 safety) to NIP-01 events with Lightning payment integration (NIP-57)."))

;; =============================================================================
;; AGENTS
;; =============================================================================

(given agent-core-available)
(given agent-transport-available)
(given agent-protocol-available)
(given agent-commerce-available)
(given agent-security-available)
(given agent-test-available)

;; =============================================================================
;; PHASE 1: CORE TYPES — Nostr event ↔ CBCL message mapping
;; =============================================================================

(given task-event-types)
(given task-sexpr-codec)
(given task-performative-tags)
(given task-message-builder)

(given no-deps-event-types)
(given no-deps-sexpr-codec)

(meta task-event-types
  (description "Define Rust types for kind 21111 (AgentMessage) and kind 31111 (AgentDialect) Nostr events. Map NIP-01 event structure (id, pubkey, created_at, kind, tags, content, sig) to typed wrappers. Include tag enums: p, performative, thread, e, dialect, t, amount, L, l.")
  (acceptance "REQ-010: All 8 core performatives representable. REQ-020: kind 21111 round-trips through serde. REQ-021: kind 31111 round-trips. NFR-010: Zero-copy deserialization for content field."))

(meta task-sexpr-codec
  (description "Integrate cbcl-rs SExpr parser/serializer for Nostr event content fields. Parse content string → SExpr, serialize SExpr → content string. Reuse cbcl-rs parse() with fuel bounds. Map Atom variants (Symbol, Str, Num, Bool, Keyword) to/from JSON-safe strings.")
  (acceptance "REQ-030: Parse all CBCL S-expression content examples from NIP-XX. REQ-031: Serialize back to identical string. NFR-020: ≤ 1µs/KiB parse (match cbcl-rs benchmark). Property test: parse(serialize(x)) == x for all valid SExpr."))

(meta task-performative-tags
  (description "Extract performative from parsed SExpr content and validate against the performative tag. Ensure head symbol of content S-expression matches the performative tag value. Handle both core (tell/ask/reply/ok/error/cancel/hello/bye) and dialect-extended performatives.")
  (acceptance "REQ-040: Reject events where content head symbol ≠ performative tag. REQ-041: Dialect performatives require dialect tag present. ADR-001: Use cbcl-rs msg_tag() for deterministic classification."))

(meta task-message-builder
  (description "Builder API for constructing kind 21111 events from CBCL message parameters. Accept performative + recipient + content + thread + optional dialect → produce complete unsigned Nostr event with correct tags. Handle broadcast messages (hello/bye) without p tag.")
  (acceptance "REQ-050: Build all example events from NIP-XX spec. REQ-051: Broadcast performatives omit p tag. REQ-052: Thread tag auto-propagated in replies. CON-010: MessageBuilder::new().tell(pubkey, content).thread(id).build() → UnsignedEvent."))

;; Phase 1 readiness
(normally r-ready-event-types
  (and task-event-types no-deps-event-types)
  ready-event-types)

(normally r-ready-sexpr-codec
  (and task-sexpr-codec no-deps-sexpr-codec)
  ready-sexpr-codec)

(normally r-ready-performative-tags
  (and task-performative-tags completed-event-types completed-sexpr-codec)
  ready-performative-tags)

(normally r-ready-message-builder
  (and task-message-builder completed-event-types completed-performative-tags)
  ready-message-builder)

;; Phase 1 assignments
(normally r-assign-core-event-types
  (and ready-event-types agent-core-available)
  assign-to-event-types-core)

(normally r-assign-core-sexpr-codec
  (and ready-sexpr-codec agent-core-available)
  assign-to-sexpr-codec-core)

(normally r-assign-core-performative-tags
  (and ready-performative-tags agent-core-available)
  assign-to-performative-tags-core)

(normally r-assign-core-message-builder
  (and ready-message-builder agent-core-available)
  assign-to-message-builder-core)

;; =============================================================================
;; PHASE 2: TRANSPORT — Relay connection & event signing
;; =============================================================================

(given task-relay-pool)
(given task-event-signing)
(given task-subscription-manager)
(given task-inbox-handler)
(given task-spam-prevention)

(meta task-relay-pool
  (description "WebSocket connection pool to Nostr relays. Connect to multiple relays, publish events, receive events. Handle reconnection, relay policy negotiation, and OK/CLOSED responses per NIP-01. Use tokio for async I/O.")
  (acceptance "REQ-060: Connect to ≥ 3 relays concurrently. REQ-061: Publish event returns OK confirmation from ≥ 1 relay. REQ-062: Automatic reconnection on disconnect. NFR-030: Event publish latency ≤ 500ms p95 to first relay OK."))

(meta task-event-signing
  (description "Sign Nostr events with secp256k1 Schnorr signatures per NIP-01. Compute event ID as sha256 of canonical serialization [0, pubkey, created_at, kind, tags, content]. Sign with agent's private key. Verify incoming event signatures. Includes NIP-44 encrypt/decrypt primitives for use by downstream encryption tasks.")
  (acceptance "REQ-070: Signed events pass NIP-01 verification. REQ-071: Invalid signatures rejected before CBCL parsing. REQ-072: Event ID computed per NIP-01 canonical serialization, verified against ≥ 3 known-good test vectors from nostr-tools. REQ-073: NIP-44 versioned encryption encrypt/decrypt exposed as public API. ADR-002: Use nostr-sdk or secp256k1 crate for crypto, do not roll own. NFR-040: Sign ≤ 100µs per event."))

(meta task-subscription-manager
  (description "Manage Nostr REQ subscriptions for agent communication patterns: inbox (messages to me), dialect listener, bounty board, agent discovery, dialect registry. Map NIP-XX filter patterns to subscription lifecycle. Handle EOSE for initial sync vs real-time.")
  (acceptance "REQ-080: All 6 subscription patterns from NIP-XX functional. REQ-081: EOSE signals transition from backfill to real-time. REQ-082: Subscription deduplication across relays. CON-020: subscribe(filter) → Stream<AgentMessage>."))

(meta task-inbox-handler
  (description "Core message dispatch: receive kind 21111 events from subscriptions, verify signature, parse CBCL content, validate performative tag consistency, route to handler by performative type. Emit typed AgentMessage to application layer. Reject messages with unknown dialect tags until the dialect is installed in the local registry (matches cbcl-rs registry search-order semantics).")
  (acceptance "REQ-090: Messages dispatched within 10ms of relay delivery. REQ-091: Invalid events (bad sig, bad CBCL, tag mismatch) rejected with structured error. REQ-092: Thread messages grouped by thread tag. REQ-093: Messages with dialect tag rejected if dialect not in local DialectRegistry, with structured UnknownDialect error."))

(meta task-spam-prevention
  (description "Implement relay-side and client-side spam defenses. Client: rate-limit outgoing messages per relay policy. Support NIP-13 proof-of-work on broadcast events. Verify incoming events against pubkey allowlists. Support zap-gating (require payment history for broadcasts).")
  (acceptance "REQ-085: POW configurable per event type (broadcast vs directed). REQ-086: Rate limiter respects relay CLOSED responses. REQ-087: Allowlist/blocklist for agent pubkeys. REQ-088: Zap-gate check queries kind 9735 before accepting broadcast tasks."))

;; Phase 2 readiness (depends on Phase 1 completion)
(normally r-ready-relay-pool
  (and task-relay-pool completed-event-types)
  ready-relay-pool)

(normally r-ready-event-signing
  (and task-event-signing completed-event-types)
  ready-event-signing)

(normally r-ready-subscription-manager
  (and task-subscription-manager completed-relay-pool completed-performative-tags)
  ready-subscription-manager)

(normally r-ready-spam-prevention
  (and task-spam-prevention completed-relay-pool completed-subscription-manager)
  ready-spam-prevention)

(normally r-ready-inbox-handler
  (and task-inbox-handler completed-subscription-manager completed-sexpr-codec completed-message-builder)
  ready-inbox-handler)

;; Phase 2 assignments
(normally r-assign-transport-relay-pool
  (and ready-relay-pool agent-transport-available)
  assign-to-relay-pool-transport)

(normally r-assign-transport-event-signing
  (and ready-event-signing agent-transport-available)
  assign-to-event-signing-transport)

(normally r-assign-transport-subscription-manager
  (and ready-subscription-manager agent-transport-available)
  assign-to-subscription-manager-transport)

(normally r-assign-security-spam-prevention
  (and ready-spam-prevention agent-security-available)
  assign-to-spam-prevention-security)

(normally r-assign-transport-inbox-handler
  (and ready-inbox-handler agent-transport-available)
  assign-to-inbox-handler-transport)

;; =============================================================================
;; PHASE 3: PROTOCOL — Discovery, conversation, dialect negotiation
;; =============================================================================

(given task-agent-profile)
(given task-agent-discovery)
(given task-conversation-threads)
(given task-dialect-negotiation)
(given task-dialect-safety)

(meta task-agent-profile
  (description "Publish agent identity as kind 0 (user metadata) per NIP-01. Set name, about, picture fields for the agent's pubkey so Nostr clients can display a human-readable identity. Publish on startup and on profile change. Query other agents' kind 0 events to resolve pubkey → display name.")
  (acceptance "REQ-095: Agent publishes kind 0 with name, about, picture on startup. REQ-096: kind 0 event replaces previous (replaceable event semantics). REQ-097: Resolve other agents' pubkeys to display names via kind 0 lookup."))

(meta task-agent-discovery
  (description "Implement hello/bye broadcast protocol. Publish hello with capabilities list and agent-type. Subscribe to hello events for agent directory. Maintain local agent registry with last-seen timestamps and capabilities. Handle bye for graceful departure.")
  (acceptance "REQ-100: hello broadcast reaches ≥ 1 relay. REQ-101: Agent registry updated within 5s of hello receipt. REQ-102: bye removes agent from active registry. REQ-103: Stale agents (no hello in 24h) marked inactive."))

(meta task-conversation-threads
  (description "Thread management for multi-turn agent conversations. Generate thread IDs, track conversation state (open/completed/cancelled), link reply chains via e tags. Support both directed (tell/ask/reply) and broadcast (hello/bye) patterns.")
  (acceptance "REQ-110: Thread state machine: open → {completed(ok), cancelled(cancel), error}. REQ-111: e tag chain preserves conversation ordering. REQ-112: Thread timeout after configurable inactivity period. CON-030: Conversation::new(thread_id) with .send()/.receive()/.complete() lifecycle."))

(meta task-dialect-negotiation
  (description "Publish and discover CBCL dialect definitions as kind 31111 addressable events. Query relay for available dialects by L/l namespace tags. Parse dialect S-expression from event content. Install verified dialects into agent's dialect registry (cbcl-rs DialectRegistry).")
  (acceptance "REQ-120: Publish dialect as kind 31111 with d tag = dialect name. REQ-121: Discover dialects by namespace query. REQ-122: Dialect content parsed and installed into cbcl-rs registry. REQ-123: Dialect messages tagged with dialect name in dialect tag."))

(meta task-dialect-safety
  (description "Verify CBCL safety constraints R1-R4 on received dialect definitions before installation. R1: no recursion (cbcl-rs verify_r1). R2: resource bounds valid (verify_r2). R3: core performatives preserved (verify_r3). R4: provenance via Nostr pubkey signature (verify_r4 using event sig as provenance).")
  (acceptance "REQ-130: All 4 safety constraints checked before dialect install. REQ-131: R4 provenance derived from Nostr event signature (author = event pubkey). REQ-132: Failed verification emits structured rejection with constraint ID. REQ-133: Malicious dialect definitions (recursive, unbounded, core-shadowing) rejected in < 100µs."))

;; Phase 3 readiness
(normally r-ready-agent-profile
  (and task-agent-profile completed-relay-pool completed-event-signing)
  ready-agent-profile)

(normally r-ready-agent-discovery
  (and task-agent-discovery completed-message-builder completed-subscription-manager completed-spam-prevention completed-agent-profile)
  ready-agent-discovery)

(normally r-ready-conversation-threads
  (and task-conversation-threads completed-inbox-handler completed-message-builder)
  ready-conversation-threads)

(normally r-ready-dialect-negotiation
  (and task-dialect-negotiation completed-relay-pool completed-sexpr-codec completed-event-signing)
  ready-dialect-negotiation)

(normally r-ready-dialect-safety
  (and task-dialect-safety completed-dialect-negotiation completed-sexpr-codec)
  ready-dialect-safety)

;; Phase 3 assignments
(normally r-assign-protocol-agent-profile
  (and ready-agent-profile agent-protocol-available)
  assign-to-agent-profile-protocol)

(normally r-assign-protocol-agent-discovery
  (and ready-agent-discovery agent-protocol-available)
  assign-to-agent-discovery-protocol)

(normally r-assign-protocol-conversation-threads
  (and ready-conversation-threads agent-protocol-available)
  assign-to-conversation-threads-protocol)

(normally r-assign-protocol-dialect-negotiation
  (and ready-dialect-negotiation agent-protocol-available)
  assign-to-dialect-negotiation-protocol)

(normally r-assign-security-dialect-safety
  (and ready-dialect-safety agent-security-available)
  assign-to-dialect-safety-security)

;; Security agent takes priority for safety verification
(prefer r-assign-security-dialect-safety r-assign-protocol-dialect-negotiation)

(meta r-assign-security-dialect-safety
  (description "Safety-critical task: dialect verification must be reviewed by security agent")
  (justification "R1-R4 constraints are the core security boundary; per USDD Tier 1 review required for cryptography-adjacent work"))

;; =============================================================================
;; PHASE 4: COMMERCE — Lightning payments & reputation
;; =============================================================================

(given task-commerce-dialect)
(given task-zap-integration)
(given task-reputation-query)
(given task-open-task-market)

(meta task-commerce-dialect
  (description "Implement the commerce dialect definition from NIP-XX: quote, accept-quote, reject-quote, counter, invoice, paid performatives. Publish as kind 31111 event. Wrap all commerce messages in (lang commerce ...). Implement negotiation state machine: open → quoted → {accepted, rejected, countered} → working → completed → invoiced → paid.")
  (acceptance "REQ-140: All 6 commerce performatives functional. REQ-141: Negotiation state machine enforced (no invoice before accept). REQ-142: Commerce messages wrapped in lang commerce. REQ-143: State transitions emitted as structured events for UI/logging."))

(meta task-zap-integration
  (description "Integrate NIP-57 Lightning Zaps for agent payment. Construct kind 9734 zap requests targeting task completion (ok) events. Parse kind 9735 zap receipts to confirm payment. Map zap amount to commerce invoice amount for reconciliation.")
  (acceptance "REQ-150: Zap request references correct ok event ID. REQ-151: Zap receipt parsed and matched to pending invoice. REQ-152: Payment confirmation emitted to commerce state machine. ADR-003: Use NIP-57 zaps, not custom payment channel."))

(meta task-reputation-query
  (description "Query agent reputation from on-relay data. Aggregate kind 9735 zap receipts for a pubkey to compute: total earnings, completion rate, domain expertise (by dialect tags). Provide reputation summary for task assignment decisions.")
  (acceptance "REQ-160: Reputation query returns earnings + completion rate for any pubkey. REQ-161: Results cacheable with configurable TTL. REQ-162: Reputation factors weighted by recency. NFR-050: Query ≤ 2s for agent with 1000 zap receipts."))

(meta task-open-task-market
  (description "Open task publishing and claiming. Publish tasks without p tag (broadcast). Support amount tag for fixed-price tasks. Implement claim protocol: agent replies to open task, conversation becomes directed. Handle concurrent claims (first-reply-wins or publisher-chooses).")
  (acceptance "REQ-170: Open tasks discoverable via bounty board subscription. REQ-171: Claim converts broadcast task to directed thread. REQ-172: Fixed-price tasks skip commerce negotiation. REQ-173: Publisher can accept/reject claims."))

;; Phase 4 readiness
(normally r-ready-commerce-dialect
  (and task-commerce-dialect completed-dialect-negotiation completed-dialect-safety completed-conversation-threads)
  ready-commerce-dialect)

(normally r-ready-zap-integration
  (and task-zap-integration completed-commerce-dialect completed-event-signing)
  ready-zap-integration)

(normally r-ready-reputation-query
  (and task-reputation-query completed-zap-integration completed-subscription-manager)
  ready-reputation-query)

(normally r-ready-open-task-market
  (and task-open-task-market completed-commerce-dialect completed-agent-discovery)
  ready-open-task-market)

;; Phase 4 assignments
(normally r-assign-commerce-commerce-dialect
  (and ready-commerce-dialect agent-commerce-available)
  assign-to-commerce-dialect-commerce)

(normally r-assign-commerce-zap-integration
  (and ready-zap-integration agent-commerce-available)
  assign-to-zap-integration-commerce)

(normally r-assign-commerce-reputation-query
  (and ready-reputation-query agent-commerce-available)
  assign-to-reputation-query-commerce)

(normally r-assign-commerce-open-task-market
  (and ready-open-task-market agent-commerce-available)
  assign-to-open-task-market-commerce)

;; =============================================================================
;; PHASE 5: SECURITY HARDENING — Encryption, spam, trust
;; =============================================================================

(given task-gift-wrap)
(given task-payment-safety)

(meta task-gift-wrap
  (description "Implement NIP-59 Gift Wrap for confidential agent communication. Wrap encrypted CBCL messages (using NIP-44 primitives from event-signing) in ephemeral-key outer events. Receiver unwraps outer event, decrypts inner content, then passes to inbox-handler for CBCL parsing. Support both encrypted direct messages and encrypted dialect definitions.")
  (acceptance "REQ-180: Gift-wrapped messages indistinguishable from other NIP-59 events to relays. REQ-181: Unwrapped + decrypted content passes all CBCL validation. REQ-182: Thread tracking preserved through wrap/unwrap cycle. REQ-183: inbox-handler transparently unwraps before CBCL dispatch. NFR-060: Wrap/unwrap ≤ 500µs per message."))

(meta task-payment-safety
  (description "Payment safety guards per NIP-XX security considerations. Verify task publisher payment history before starting work. Validate amount tag consistency across negotiation. Detect and warn about payment-before-work patterns. Implement configurable trust thresholds.")
  (acceptance "REQ-200: Agent checks publisher zap history before claiming task. REQ-201: Amount consistency validated across quote/accept/invoice chain. REQ-202: Configurable minimum publisher reputation threshold. REQ-203: Warning emitted for first-time publishers with no history."))

;; Phase 5 readiness
(normally r-ready-gift-wrap
  (and task-gift-wrap completed-inbox-handler completed-message-builder completed-event-signing)
  ready-gift-wrap)

(normally r-ready-payment-safety
  (and task-payment-safety completed-reputation-query completed-zap-integration)
  ready-payment-safety)

;; Phase 5 assignments — security agent for all
(normally r-assign-security-gift-wrap
  (and ready-gift-wrap agent-security-available)
  assign-to-gift-wrap-security)

(normally r-assign-security-payment-safety
  (and ready-payment-safety agent-security-available)
  assign-to-payment-safety-security)

;; =============================================================================
;; PHASE 6: INTEGRATION TESTING & VALIDATION
;; =============================================================================

(given task-integration-tests)
(given task-differential-tests)
(given task-e2e-scenario)

(meta task-integration-tests
  (description "Integration tests against real Nostr relays (test instances). Verify full message flow: sign → publish → subscribe → receive → parse → dispatch. Test dialect publish/discover/verify/install cycle. Test conversation thread lifecycle end-to-end.")
  (acceptance "REQ-210: Tests run against ≥ 2 Nostr test relays. REQ-211: Full message round-trip verified for all 8 core performatives. REQ-212: Dialect lifecycle test covers publish → discover → R1-R4 verify → install → use. TEST-001 through TEST-008: One test per core performative."))

(meta task-differential-tests
  (description "Cross-verify CBCL message parsing between cbcl-nostr and cbcl-rs. Reuse cbcl-rs 156 test vectors. Ensure Nostr event wrapping does not alter CBCL semantics. Verify that parse(event.content) produces identical SExpr in both implementations.")
  (acceptance "REQ-220: All 156 cbcl-rs test vectors pass through Nostr event round-trip. REQ-221: No semantic drift between cbcl-rs parse and cbcl-nostr parse. NFR-070: Differential test suite runs in ≤ 30s."))

(meta task-e2e-scenario
  (description "End-to-end scenario: two agents discover each other, negotiate a commerce dialect, publish an open task with bounty, claim it, negotiate price, complete work, invoice, and pay via Lightning zap. Full NIP-XX happy path in a single test.")
  (acceptance "REQ-230: Scenario completes with zap receipt confirming payment. REQ-231: All conversation events verifiable on relay after test. REQ-232: Reputation query reflects completed task post-scenario."))

;; Phase 6 readiness
(normally r-ready-integration-tests
  (and task-integration-tests completed-inbox-handler completed-conversation-threads completed-dialect-safety)
  ready-integration-tests)

(normally r-ready-differential-tests
  (and task-differential-tests completed-sexpr-codec completed-event-types)
  ready-differential-tests)

(normally r-ready-e2e-scenario
  (and task-e2e-scenario completed-integration-tests completed-open-task-market completed-zap-integration completed-reputation-query)
  ready-e2e-scenario)

;; Phase 6 assignments
(normally r-assign-test-integration-tests
  (and ready-integration-tests agent-test-available)
  assign-to-integration-tests-test)

(normally r-assign-test-differential-tests
  (and ready-differential-tests agent-test-available)
  assign-to-differential-tests-test)

(normally r-assign-test-e2e-scenario
  (and ready-e2e-scenario agent-test-available)
  assign-to-e2e-scenario-test)

